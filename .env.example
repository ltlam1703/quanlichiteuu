# ══════════════════════════════════════════════════
#  .env.example — Copy thành .env rồi điền giá trị
#  KHÔNG commit file .env lên git
# ══════════════════════════════════════════════════

# ── MongoDB (local Docker) ────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_password_here
MONGO_INITDB_DATABASE=expense_tracker

# ── MongoDB URI ───────────────────────────────────
# Chạy local với Docker:
MONGO_URI=mongodb://admin:your_password_here@mongo:27017/expense_tracker?authSource=admin
# Dùng MongoDB Atlas (production trên Render):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense_tracker?retryWrites=true&w=majority

# ── Ports ─────────────────────────────────────────
MONGO_PORT=27017
API_PORT=3000
FRONTEND_PORT=8080

# ── API ───────────────────────────────────────────
PORT=3000
JWT_SECRET=một_chuỗi_bí_mật_nào_đó